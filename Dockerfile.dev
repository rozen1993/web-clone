FROM node:24-alpine

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm install

# Source files are mounted as a volume at runtime for hot reload

EXPOSE 3000

ENV NODE_ENV=development

# --host makes the Astro dev server bind 0.0.0.0 so it is reachable from outside
# the container; by default it only listens on localhost.
CMD ["npm", "run", "dev", "--", "--host", "--port", "3000"]
